#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95 # Run late in the boot process

# Configuration
LOG_FILE="/mnt/gps.nmea"
FIFO_FILE="/mnt/gps.fifo"
MAX_SIZE_KB=100
KEEP_LINES=500

start_service() {
    # Ensure the FIFO exists
    [ -p "$FIFO_FILE" ] || mkfifo "$FIFO_FILE"

    # Create the log file if it does not exist yet so tail -F does not
    # error out before gpsd starts writing.
    [ -f "$LOG_FILE" ] || touch "$LOG_FILE"

    # Start the bridge: tail -F follows by name and handles truncation /
    # rotation correctly, unlike tail -f which follows the inode.
    procd_open_instance "bridge"
    procd_set_param command sh -c "/usr/bin/tail -F $LOG_FILE > $FIFO_FILE 2>/dev/null"
    procd_set_param respawn
    procd_close_instance
    echo "GPS_BRIDGE: startup of the pipeline complete..." > /dev/kmsg

    # Start the janitor to keep the file from growing unbounded.
    # Instead of a hard truncation (which loses data), keep the most
    # recent KEEP_LINES lines so the station binary does not miss fixes.
    procd_open_instance "janitor"
    procd_set_param command sh -c "while true; do
        if [ -f $LOG_FILE ]; then
            FILE_SIZE=\$(du -k $LOG_FILE 2>/dev/null | cut -f1)
            if [ -n \"\$FILE_SIZE\" ] && [ \"\$FILE_SIZE\" -gt $MAX_SIZE_KB ]; then
                echo \"GPS_BRIDGE: $LOG_FILE reached \${FILE_SIZE}KB, trimming to last $KEEP_LINES lines\" > /dev/kmsg
                tail -n $KEEP_LINES $LOG_FILE > ${LOG_FILE}.tmp && mv ${LOG_FILE}.tmp $LOG_FILE
            fi
        fi
        sleep 60
    done"
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    rm -f "$FIFO_FILE"
}
